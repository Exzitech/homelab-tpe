# Copier en .env (chmod 600) a cote du docker-compose.yml. Ne jamais committer le .env.
DOMAINE=exemple.fr
DONNEES=/srv/data
# dossier Nextcloud surveille : <donnees nextcloud>/<compte>/files/<dossier>
NEXTCLOUD_ENTREE=/srv/data/nextcloud/html/data/alice/files/A classer

# Cle Django : openssl rand -hex 32
PAPERLESS_SECRET_KEY=
# Premier demarrage seulement : cree le compte admin, puis retirer ces deux lignes.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
