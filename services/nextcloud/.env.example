# Copier en .env (chmod 600) a cote du docker-compose.yml. Ne jamais committer le .env.
DOMAINE=exemple.fr
DONNEES=/srv/data

# openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Vide = /admin coupe. Pour creer les comptes : docker run --rm -it vaultwarden/server /vaultwarden hash
# puis coller le hash ici (en doublant chaque $ en $$), redemarrer, inviter, et revider.
VW_ADMIN_TOKEN=
VW_PUSH_INSTALLATION_ID=
VW_PUSH_INSTALLATION_KEY=
